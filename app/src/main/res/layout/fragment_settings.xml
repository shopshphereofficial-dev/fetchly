<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTheme"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:stateListAnimator="@null"
            android:text="@string/pref_theme"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:stateListAnimator="@null"
            android:text="@string/pref_language"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWifi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:stateListAnimator="@null"
            android:text="@string/pref_wifi_only"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEngine"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:stateListAnimator="@null"
            android:text="@string/pref_engine"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearBookmarks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:text="@string/clear_bookmarks"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:text="@string/clear_history_data"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:text="@string/clear_search"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="@string/about_text"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
